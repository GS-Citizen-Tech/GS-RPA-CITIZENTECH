# Copie para .env e ajuste se quiser:  cp .env.example .env
# O .env NÃO vai para o Git (está no .gitignore). Os valores abaixo já são o padrão do código.

# ---------- API do Quem Resolve? (CONTRATOS.md, seção E) ----------
# Vazio = usa o SQLite local (data/quem_resolve.db). Para testar o caminho via API: python -m src.mock_api
# e use API_BASE_URL=http://127.0.0.1:8156
API_BASE_URL=
API_TOKEN=

# ---------- E-mail (padrão: SMTP local de teste, sem credenciais) ----------
# Se ninguém estiver escutando em localhost:1025, o robô sobe um SMTP de teste embutido (SMTP_AUTO_LOCAL=true).
# Para ver os e-mails na tela, suba antes:  python -m aiosmtpd -n -l localhost:1025
SMTP_AUTO_LOCAL=true
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=false
EMAIL_REMETENTE=robo@quemresolve.local
# Trava de segurança: o robô só envia para estes domínios (caixas fictícias)
DOMINIOS_DESTINO_PERMITIDOS=caixa-teste.local

# Opcional - Mailtrap (sandbox): copie host, porta, usuário e senha do seu inbox de teste
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORTA=2525
# SMTP_USUARIO=seu_usuario_mailtrap
# SMTP_SENHA=sua_senha_mailtrap
# SMTP_STARTTLS=true

# ---------- Scraping ----------
SCRAPER_USER_AGENT=QuemResolveBot/1.0 (prototipo academico FIAP GS2026; coleta de paginas publicas; baixa frequencia)
SCRAPER_ATRASO_SEGUNDOS=2
CHUNK_MAX_CARACTERES=700

# ---------- Resiliência ----------
TIMEOUT_HTTP=10
TENTATIVAS=3
BACKOFF_SEGUNDOS=1
MAX_FALHAS_SEGUIDAS=3

# ---------- Decisão da IA ----------
LIMIAR_CONFIANCA=0.40
LIMIAR_ETIQUETA_DOCS=0.30
